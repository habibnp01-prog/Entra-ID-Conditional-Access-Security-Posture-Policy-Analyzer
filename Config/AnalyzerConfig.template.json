{
  "version": "1.0.0",
  "tenant": {
    "tenantId": "REPLACE-WITH-TENANT-ID",
    "clientId": "REPLACE-WITH-CLIENT-ID",
    "certificateThumbprint": "REPLACE-WITH-CERT-THUMBPRINT"
  },
  "graph": {
    "scopes": ["Policy.Read.All", "Directory.Read.All", "Application.Read.All", "RoleManagement.Read.Directory"],
    "baseUrl": "https://graph.microsoft.com/v1.0"
  },
  "requiredModules": [
    { "name": "Microsoft.Graph", "minimumVersion": "2.0.0" },
    { "name": "Pester", "minimumVersion": "5.0.0" }
  ],
  "analysis": {
    "includeDisabledPolicies": true,
    "includeReportOnlyPolicies": true,
    "resolveGroupMembers": false,
    "maxGroupMembersToResolve": 100
  },
  "output": {
    "reportPath": "Reports",
    "logPath": "Logs",
    "formats": ["CSV", "JSON", "HTML"]
  },
  "logging": {
    "level": "Information",
    "enableAudit": true,
    "enableAssessment": true,
    "enableErrors": true
  }
}
